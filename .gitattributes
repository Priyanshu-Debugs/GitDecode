*.py linguist-detectable=true linguist-language=Python

# Exclude third-party UI libraries (shadcn/ui & ai-elements) as vendored code
frontend/components/** linguist-vendored
frontend/components/** linguist-detectable=false

# Exclude landing demo widgets and complex dashboard mockups
# Trims TypeScript to ~206 KB and CSS to ~114 KB so Python (~433 KB) dominates #1
frontend/app/components/** linguist-detectable=false
frontend/app/dashboard/** linguist-detectable=false

# Ensure CSS, JavaScript, and Dockerfile are detected for a complete breakdown
*.css linguist-detectable=true
*.mjs linguist-detectable=true linguist-language=JavaScript
Dockerfile linguist-detectable=true